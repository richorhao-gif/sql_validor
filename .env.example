# ─────────────────────────────────────────────────────────────
# SQL 脚本变更校验智能体 — 环境变量配置模板
# 复制本文件为 .env 并按说明填入真实值
# ─────────────────────────────────────────────────────────────

# ── LLM 配置 ──────────────────────────────────────────────────
# 支持 openai | anthropic
LLM_PROVIDER=openai

# API Key（必填）
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# 模型名称
LLM_MODEL=gpt-4o

# 自定义 API 地址（可选，用于 OpenAI 兼容接口，如 Azure、DeepSeek、Qwen 等）
# LLM_BASE_URL=https://api.xxx.com/v1

# 温度参数（0.0 ~ 1.0，推荐 0.0 以保证输出稳定性）
LLM_TEMPERATURE=0.0

# 调用失败最大重试次数
LLM_MAX_RETRIES=3

# ── 数据库配置 ─────────────────────────────────────────────────
# PostgreSQL 连接字符串（必填，智能体只执行 SELECT，不写库）
POSTGRES_DSN=postgresql://username:password@localhost:5432/your_database
# Docker 本地测试库（docker compose up -d 后使用）：
# POSTGRES_DSN=postgresql://validator:validator123@localhost:5432/dw_dev

# ── 运行参数 ───────────────────────────────────────────────────
# 单次发版最大 SQL 文件数（默认 20）
MAX_SQL_FILES=20

# MD 报告输出目录（默认 ./reports）
OUTPUT_DIR=./reports

# ── 可观测性：LangFuse 本地 Agent 追踪 ────────────────────────
# LANGFUSE_HOST=http://localhost:3000
# LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
