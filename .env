# ── LLM 配置 ──────────────────────────────────────────────────
# 支持 openai | anthropic
LLM_PROVIDER=openai

# API Key（必填）
LLM_API_KEY=sk-6b4dbd31c67647e7964786868fab42b8

# 模型名称
LLM_MODEL=deepseek-v4-flash

# 自定义 API 地址
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 温度参数
LLM_TEMPERATURE=0.0

# 调用失败最大重试次数
LLM_MAX_RETRIES=3

# ── 数据库配置 ─────────────────────────────────────────────────
# Docker 本地测试库（docker compose up -d 启动后使用此连接串）
POSTGRES_DSN=postgresql://validator:validator123@localhost:5432/dw_dev

# ── 运行参数 ───────────────────────────────────────────────────
# 单次发版最大 SQL 文件数（默认 20）
MAX_SQL_FILES=20

# MD 报告输出目录（默认 ./reports）
OUTPUT_DIR=./reports

# ── 可观测性：LangFuse 本地 Agent 追踪 ───────────────────────
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=pk-lf-63034dbc-f90a-4b52-b20d-72af4000adee
LANGFUSE_SECRET_KEY=sk-lf-3ef8a608-12f9-40a9-8c70-4447a313fa98
