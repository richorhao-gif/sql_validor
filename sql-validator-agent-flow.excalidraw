    {
      "id": "node_dca_desc",
      "type": "text",
      "x": 728,
      "y": 443,
      "width": 644,
      "height": 86,
      "text": "LangGraph create_react_agent 构建 ReAct 子图（自主推理 + 工具调用循环）\nSQLDatabaseToolkit（只读）：sql_db_list_tables / sql_db_schema / SafeQueryTool\nAgent 自主决定查询哪些表，追查外键和隐式依赖\nLLM with_structured_output(DBSnapshot) 将对话文本结构化 → db_snapshot",
      "fontSize": 12,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "version": 2,
      "versionNonce": 443931554,
      "index": "aC",
      "isDeleted": false,
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "seed": 1,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1777511476388,
      "link": null,
      "locked": false,
      "containerId": null,
      "originalText": "LangGraph create_react_agent 构建 ReAct 子图（自主推理 + 工具调用循环）\nSQLDatabaseToolkit（只读）：sql_db_list_tables / sql_db_schema / SafeQueryTool\nAgent 自主决定查询哪些表，追查外键和隐式依赖\nLLM with_structured_output(DBSnapshot) 将对话文本结构化 → db_snapshot",
      "autoResize": true,
      "lineHeight": 1.7916666666666667
    },
