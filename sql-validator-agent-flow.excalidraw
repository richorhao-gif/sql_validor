    {
      "id": "node_fa1_desc",
      "type": "text",
      "x": 208,
      "y": 699,
      "width": 444,
      "height": 78,
      "text": "FileAnalyzerInput（Send API 专用 Schema）\nStep1：sqlglot 解析 → ParsedScript + SyntaxIssue\nStep2：DBComparator 快照比对 → 差异 SyntaxIssue\nStep3：LLM 一次调用生成 intent_summary\n结果追加到主图 parsed_scripts / raw_syntax_issues",
      "fontSize": 11,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "version": 2,
      "versionNonce": 125958818,
      "index": "aK",
      "isDeleted": false,
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "seed": 1,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1777511476388,
      "link": null,
      "locked": false,
      "containerId": null,
      "originalText": "FileAnalyzerInput（Send API 专用 Schema）\nStep1：sqlglot 解析 → ParsedScript + SyntaxIssue\nStep2：DBComparator 快照比对 → 差异 SyntaxIssue\nStep3：LLM 一次调用生成 intent_summary\n结果追加到主图 parsed_scripts / raw_syntax_issues",
      "autoResize": true,
