      "opacity": 100,
      "angle": 0,
      "seed": 1,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1777511760931,
      "link": null,
      "locked": false,
      "containerId": null,
      "originalText": "core/dependency.py 纯算法：拓扑排序计算 execution_order / dependency_map\n检测循环依赖（cycle_paths），如存在写入 errors 字段\nLLM with_structured_output(DependencyGraph) 补充 analysis_notes\n算法结果优先，LLM 仅覆盖 analysis_notes（防止 LLM 乱改顺序）",
      "autoResize": true,
      "lineHeight": 1.5833333333333333
    },
